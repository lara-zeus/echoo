{
    "name": "lara-zeus/echoo",
    "description": "Zeus Echoo is filamentphp form component to record audio from your browser",
    "keywords": [
      "laravel",
      "lara-zeus",
      "ui",
      "tooltip",
      "tippy",
      "accordion",
      "code",
      "design",
      "input",
      "coulmn",
      "field",
      "generator",
      "filamentphp",
      "audio",
      "recorder",
      "voice"
    ],
    "homepage": "https://larazeus.com/echoo",
    "support": {
        "issues": "https://github.com/lara-zeus/echoo/issues",
        "source": "https://github.com/lara-zeus/echoo"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Lara Zeus",
            "email": "info@larazeus.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.19"
    },
  "require-dev": {
    "larastan/larastan": "^3.4",
    "laravel/pint": "^1.0",
    "nunomaduro/collision": "^8.0",
    "nunomaduro/phpinsights": "^2.8",
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "*",
    "pestphp/pest-plugin-laravel": "*",
    "pestphp/pest-plugin-livewire": "*",
    "phpstan/extension-installer": "^1.1"
  },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Echoo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "pint": "vendor/bin/pint",
    "test": "vendor/bin/pest",
    "test:pest": "vendor/bin/pest --parallel",
    "test:phpstan": "vendor/bin/phpstan analyse"
  },
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Echoo\\EchooServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
